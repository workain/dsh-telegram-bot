{
  "name": "@workain/dsh-telegram-bot",
  "version": "0.3.0-dev.1",
  "description": "Telegram sessions, topics, model controls and approvals for DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "session-api.js",
    "session-watch.js",
    "state-validation.js",
    "session-selection.js",
    "user-access.js",
    "topic-recovery.js",
    "session-history.js",
    "mirrored-interaction.js",
    "session-link.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "ACCEPTANCE.md",
    "CREDITS.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "telegramify-markdown": "^1.3.3"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "telegram",
    "bot"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workain/dsh-telegram-bot.git"
  },
  "homepage": "https://github.com/workain/dsh-telegram-bot#readme",
  "bugs": {
    "url": "https://github.com/workain/dsh-telegram-bot/issues"
  },
  "scripts": {
    "test": "NODE_ENV=test node --test"
  }
}
